# Only what the images build from: model/, interface/, frontend/, gateway/, pyproject, uv.lock (all three Dockerfiles).
.git
.github
.claude
.venv
.pytest_cache
**/__pycache__
**/node_modules
frontend/dist
# The gateway's local build output: the image restores and publishes from source (gateway/Dockerfile); its
# appsettings*.json and launchSettings.json stay in the context.
gateway/**/bin
gateway/**/obj
docs
tests
tools
# The bundle export runs in the image (S72, BUILD_IV W2): its one tool is re-included.
!tools/export_template.py
*.md
!README.md
.env
*.token
*.pem
