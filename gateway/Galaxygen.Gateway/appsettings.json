{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Model": {
      "BaseUrl": "http://localhost:8017",
      "TimeoutSeconds": 120
    },
    "Limits": {
      "PermitPerWindow": 60,
      "WindowSeconds": 60,
      "ConcurrentModelRequests": 1,
      "ModelQueue": 64,
      "ConcurrentGenerates": 1,
      "GenerateQueue": 10
    },
    "Frontend": { "Path": "../../frontend/dist" }
  }
}
