#!/bin/sh
# Refuse to commit staged content that looks like a GitHub token (rule C2c).
#
# Matches the *shape* of a token -- prefix followed by at least 20 token
# characters -- rather than the bare prefix, because RULES.md, GALAXY_PLAN.md
# and S0_PROMPT.md all mention the bare prefixes in prose and must stay
# committable. The bracketed characters in the patterns keep this file from
# matching itself.
#
# Installed per clone by tools/bootstrap.py (git config core.hooksPath tools/hooks).

pattern='gh[p]_[A-Za-z0-9]{20,}|github_[p]at_[A-Za-z0-9_]{20,}'

if git diff --cached -U0 --no-color | grep -E '^\+' | grep -E "$pattern" >/dev/null 2>&1; then
    echo "pre-commit: staged content matches a GitHub token shape. Refusing (RULES.md C2c)." >&2
    echo "pre-commit: offending staged lines:" >&2
    git diff --cached -U0 --no-color | grep -E '^\+' | grep -E -n "$pattern" | sed 's/^/    /' >&2
    exit 1
fi
exit 0
